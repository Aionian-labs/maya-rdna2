From 0759f31ea083197fb68c6d21c9efb4081928c25a Mon Sep 17 00:00:00 2001
From: Claude Opus 5.5 <noreply@anthropic.com>
Date: Mon, 12 Oct 2026 08:55:45 +0000
Subject: [PATCH 6/6] maya.py: let the HIP installer split across more than two
 GPUs (experiment)

The engine's layer split takes up to 16 parts (kMaxParts); only the HIP
installer check limited AMD to two cards. Untested upstream on HIP: this is to
try all six RX 6700 XT so that every expert fits in VRAM + the RAM tier.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 maya.py | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/maya.py b/maya.py
index b50c614..3fae75a 100755
--- a/maya.py
+++ b/maya.py
@@ -467,8 +467,8 @@ def check_hip_pc(a, installed=False) -> dict:
             want = [int(x) for x in str(a.gpus).split(",") if x.strip()]
         except ValueError:
             fail(f"--gpus takes two GPU numbers as --check shows them, e.g. --gpus 0,1, not {a.gpus!r}")
-        if len(want) != 2 or want[0] == want[1]:
-            fail("Maya's HIP port runs on one GPU or splits the model across two: --gpu 0, or --gpus 0,1")
+        if not 2 <= len(want) <= MAX_GPUS or len(set(want)) != len(want):
+            fail(f"Maya's HIP port runs on one GPU or splits the model across 2-{MAX_GPUS}: --gpu 0, or --gpus 0,1")
         picked = [next((g for g in usable if g["index"] == i), None) for i in want]
         for i, g in zip(want, picked):
             if g is None:
@@ -523,7 +523,7 @@ def check_hip_pc(a, installed=False) -> dict:
         fail(f"the CPU ({cpu}) needs AVX2 for the expert lane")
     total, avail = mem_gb()
     ok(f"using {' + '.join(gpu_label(g) for g in chosen)}; experimental HIP, "
-       f"{'two GPUs (layer split)' if len(chosen) == 2 else 'one GPU'}, text only")
+       f"{f'{len(chosen)} GPUs (layer split)' if len(chosen) >= 2 else 'one GPU'}, text only")
     ok(f"ROCm: {root}; CPU: {cpu} ({'AVX-512' if avx512 else 'AVX2'})")
     ok(f"RAM: {total:.0f} GB, {avail:.0f} GB available now")
     if any(hip_unified_memory(g) for g in chosen) and WIN:
-- 
